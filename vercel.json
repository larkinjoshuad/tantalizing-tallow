{
  "buildCommand": "npm run build:full",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/cart/:path*",
      "destination": "https://tantalizingtallow.myshopify.com/cart/:path*",
      "permanent": false
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://tantalizingtallow.myshopify.com/checkout/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/og-image", "destination": "/api/og-image" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/cdn/:path*", "destination": "https://tantalizingtallow.myshopify.com/cdn/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.shopify.com https://*.myshopify.com; font-src 'self' data:; connect-src 'self' https://vitals.vercel-insights.com https://tantalizingtallow.myshopify.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.myshopify.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
